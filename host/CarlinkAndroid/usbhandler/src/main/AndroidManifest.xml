<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The package name is the fixed-handler identity GM grants on USB attach. The activity
         configured by GM is deliberately NOT declared: on the truck, an absent activity is
         tolerated after the silent grant, while declaring it causes a distraction overlay. See
         the validated original Carlink helper behavior documented in OCBMANDROID.md. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <service
            android:name="com.carlink.usbhelper.UsbBridgeService"
            android:exported="true" />

        <!-- GoogleTemplatesHost uses this provider to transfer maneuver icons to the cluster. -->
        <provider
            android:name="com.carlink.usbhelper.ClusterIconProvider"
            android:authorities="com.google.android.apps.automotive.templates.host.ClusterIconContentProvider"
            android:exported="true"
            android:grantUriPermissions="true" />

    </application>

</manifest>
