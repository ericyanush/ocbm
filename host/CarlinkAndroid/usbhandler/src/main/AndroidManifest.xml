<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The package name is the fixed-handler identity GM grants on USB attach. The activity
         configured by GM is deliberately NOT declared: on the truck, an absent activity is
         tolerated after the silent grant, while declaring it causes a distraction overlay. See
         the validated original Carlink helper behavior documented in OCBMANDROID.md. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <!-- USB ownership remains in this UID. The started/bound service does not start a
             foreground service or launch UI. -->
        <service
            android:name="com.carlink.usbhelper.UsbBridgeService"
            android:exported="true" />

    </application>

</manifest>
