<?xml version="1.0" encoding="utf-8"?>
<!--
    AAOS enumerates apps by the <uses name="..."/> entries here.
    - media : required so AAOS Media Center lists Carlink as a selectable source
              (the MediaBrowserService intent-filter is necessary but not sufficient)

    - template/navigation : opt-in Car App Library service for turn-by-turn cluster guidance.
      The service starts disabled and is enabled by the user's Cluster Navigation setting.
-->
<automotiveApp>
    <uses name="media"/>
    <uses name="template"/>
    <uses name="navigation"/>
</automotiveApp>
